#!/usr/bin/env bash
set -euo pipefail

REPO="Happ-proxy/happ-desktop"
CASK_FILE="$(cd "$(dirname "$0")/.." && pwd)/Casks/happ-desktop.rb"
API_URL="https://api.github.com/repos/${REPO}/releases"

curl_args=(
  -fsSL
  -H "Accept: application/vnd.github+json"
  -H "X-GitHub-Api-Version: 2022-11-28"
  -H "User-Agent: homebrew-tap-updater"
)

if [[ -n "${GITHUB_TOKEN:-}" ]]; then
  curl_args+=( -H "Authorization: Bearer ${GITHUB_TOKEN}" )
fi

json=$(curl "${curl_args[@]}" "$API_URL")
release_json=$(printf '%s' "$json" | ruby -rjson -e '
  releases = JSON.parse(STDIN.read)
  release = releases.find { |item| !item.fetch("draft") }
  abort "No non-draft release found" if release.nil?
  puts JSON.generate(release)
')
tag=$(printf '%s' "$release_json" | ruby -rjson -e 'j=JSON.parse(STDIN.read); puts j.fetch("tag_name")')
version=${tag#v}
asset=$(printf '%s' "$release_json" | ruby -rjson -e 'j=JSON.parse(STDIN.read); puts j.fetch("assets").map { |a| a["name"] }.find { |name| name == "Happ.macOS.universal.dmg" }')

if [[ -z "$asset" ]]; then
  echo "No universal macOS DMG asset found in latest non-draft release" >&2
  exit 1
fi

cat > "$CASK_FILE" <<CASK
cask "happ-desktop" do
  version "${version}"
  sha256 :no_check

  url "https://github.com/Happ-proxy/happ-desktop/releases/download/#{version}/${asset}"
  name "Happ Desktop"
  desc "Desktop client for Happ proxy"
  homepage "https://github.com/Happ-proxy/happ-desktop"

  livecheck do
    url "https://api.github.com/repos/Happ-proxy/happ-desktop/releases"
    strategy :json do |json|
      json.map do |release|
        next if release["draft"]

        release["tag_name"]&.delete_prefix("v")
      end
    end
  end

  app "Happ.app"
end
CASK

echo "Updated ${CASK_FILE} to ${version} (${asset})"
